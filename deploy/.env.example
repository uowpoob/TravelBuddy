# Copy to deploy/.env. Run Compose with --env-file deploy/.env from the repository root.
# Use a random hexadecimal password (32+ characters) to avoid DSN escaping problems.
POSTGRES_PASSWORD=
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

GD_API_KEY=
GD_JSAPI_KEY=
GD_JSAPI_SECURITY_CODE=
GD_MCP_URL=https://mcp.amap.com/mcp
GD_MCP_TIMEOUT_SECONDS=30
GD_MCP_CACHE_ENABLED=true
GD_MCP_CACHE_TTL_SECONDS=3600
GD_MCP_CACHE_TIMEOUT_SECONDS=0.5

LANGSMITH_TRACING=false
LANGSMITH_PROJECT=travelbuddy
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Local deployment: http://127.0.0.1:8080
# Cloud deployment behind a host reverse proxy: keep 127.0.0.1 and add HTTPS there.
# To expose HTTP directly for a temporary demo, change to 0.0.0.0.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
