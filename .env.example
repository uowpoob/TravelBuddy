
# Copy to .env and fill in credentials locally. Never commit .env.
# URI passwords containing special characters must be URL encoded.
DATABASE_DSN=postgresql://travelbuddy:YOUR_PASSWORD@127.0.0.1:5432/travelbuddy

# Optional checkpoint database. Empty/unset uses process-local memory.
# For persistence, set a PostgreSQL DSN (may be the same value as DATABASE_DSN).
# Then run: uv run python -m backend.scripts.init_checkpoints
LANGGRAPH_PG_DSN=

# JWT signing key: generate locally, never commit it or reuse another API key.
# At least 32 bytes. Lifetime is 1-1440 minutes; restart after changing it.
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# DeepSeek: use your provider's base URL and an available model ID.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# AMap Web Service key for backend MCP tools.
GD_API_KEY=
# Official Streamable HTTP endpoint; do not put the key in this URL.
GD_MCP_URL=https://mcp.amap.com/mcp
# Timeout for each MCP request (seconds, must be positive).
GD_MCP_TIMEOUT_SECONDS=30
# Shared Redis cache for read-only MCP results and tool discovery.
# Empty REDIS_URL or CACHE_ENABLED=false disables caching; outages bypass Redis.
REDIS_URL=redis://127.0.0.1:6379/0
GD_MCP_CACHE_ENABLED=true
GD_MCP_CACHE_NAMESPACE=travelbuddy:dev:mcp:v1
# All cached tools use the same TTL, in seconds. 0 disables caching.
GD_MCP_CACHE_TTL_SECONDS=3600
GD_MCP_CACHE_TIMEOUT_SECONDS=0.5

# AMap Web (JS API) key and its matching securityJsCode.
# Keep the security code server-side when deploying with a proxy.
GD_JSAPI_KEY=
GD_JSAPI_SECURITY_CODE=

# Route requests use GD_API_KEY; cache is process-local and expires after this TTL.
GD_ROUTE_TIMEOUT_SECONDS=15
GD_ROUTE_CACHE_TTL_SECONDS=900
GD_ROUTE_CACHE_MAX_ENTRIES=512

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travelbuddy
